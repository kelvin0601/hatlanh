# Neon PostgreSQL database
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Gửi email xác nhận đơn hàng và thông báo liên hệ qua Resend
RESEND_API_KEY=re_xxxxxxxxx
ORDER_FROM_EMAIL="An Vị <orders@your-verified-domain.com>"
STORE_NOTIFICATION_EMAIL=hello@your-domain.com

# Tài khoản owner được tạo ở lần đăng nhập đầu tiên
ADMIN_BOOTSTRAP_USERNAME="owner"
ADMIN_BOOTSTRAP_PASSWORD=""
# Tối thiểu 32 ký tự ngẫu nhiên: openssl rand -base64 48
ADMIN_SESSION_SECRET=""
